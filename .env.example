# Reem voice agent — environment variables
# Copy to `.env` and fill in. Never commit your real `.env`.

# --- Twilio (PSTN inbound) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Use a scoped API key (SID + secret) — survives shared accounts where
# someone else might rotate the account auth token.
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=+49...

# --- Gradium (German STT + TTS) ---
GRADIUM_API_KEY=
# Default voice = "Samantha" (mn5sS7D8kYKETZXA) — Gradium English flagship
# feminine, "warm and professional American adult". Mid-band energy, not
# "airy", so it survives μ-law 8 kHz telephony.
GRADIUM_VOICE_ID=mn5sS7D8kYKETZXA

# --- Google Gemini ---
GOOGLE_API_KEY=

# --- Tavily (optional, for code-mode tavily.research lookups) ---
TAVILY_API_KEY=

# --- HUD relay (local websocket port the FastAPI server binds to) ---
HUD_WS_PORT=8765

# --- Public host for Twilio Media Streams ---
# Production: the Cloudflare custom domain pointing at the deployed
# Container (see wrangler.jsonc). For local dev, use a tunnel hostname.
PUBLIC_HOST=reem.example.com
